# GEMINI_API_KEY: server-side only (read in server.ts). Never exposed to
# the browser — the old client-side Gemini calls were removed because they
# baked this key into the JS bundle.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NAVER API CREDENTIALS
# Used for Naver Local Search API
NAVER_CLIENT_ID="YOUR_NAVER_CLIENT_ID"
NAVER_CLIENT_SECRET="YOUR_NAVER_CLIENT_SECRET"

# FIREBASE CONFIGURATION
# Used for storing enriched leads and tracking outreach status
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
